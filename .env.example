# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Recommended: server-only key (never referenced from src/, never shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Fallback if you stay on the anon key (requires section 4 of supabase/schema.sql).
VITE_SUPABASE_ANON_KEY=

# Long random string; keeps IP hashes from being reversible. e.g. `openssl rand -hex 32`
SCAN_HASH_SALT=
